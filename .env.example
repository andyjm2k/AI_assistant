# Example CATBot environment file.
# Copy to .env and fill in the sections that match the features you want to use.

# === Core LLM / MCP configuration ===
# Supported providers: openai, minimax, anthropic, google, azure_openai, groq, deepseek,
# cerebras, ollama, bedrock, browser_use, openrouter, vercel
MCP_LLM_PROVIDER=ollama
MCP_LLM_MODEL_NAME=llama3.2
# Generic provider/base override (for Ollama or OpenAI-compatible providers)
MCP_LLM_BASE_URL=http://localhost:11434
# Optional generic key override. If set, it takes precedence over provider-specific keys.
# MCP_LLM_API_KEY=

# Provider-specific MCP-prefixed keys
# MCP_LLM_OPENAI_API_KEY=
# MCP_LLM_MINIMAX_API_KEY=
# MCP_LLM_GOOGLE_API_KEY=
# MCP_LLM_ANTHROPIC_API_KEY=
# MCP_LLM_OPENROUTER_API_KEY=
# MCP_LLM_AZURE_OPENAI_API_KEY=
# MCP_LLM_DEEPSEEK_API_KEY=
# MCP_LLM_AZURE_ENDPOINT=https://your-resource.openai.azure.com
# MCP_LLM_AZURE_API_VERSION=2024-02-01
# MCP_LLM_AWS_REGION=us-east-1

# Standard provider aliases used by several CATBot modules directly.
# The install wizard writes these automatically for supported providers.
# OPENAI_API_KEY=
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_ORG_ID=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT_ID=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# MINIMAX_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# AZURE_OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Legacy browser bridge compatibility (used by older LangChain browser helpers)
MCP_MODEL_PROVIDER=ollama
MCP_MODEL_NAME=llama3.2
MCP_MODEL_BASE_URL=http://localhost:11434/v1
# MCP_TEMPERATURE=0.1

# === Browser / browser-use configuration ===
MCP_BROWSER_HEADLESS=false
# MCP_BROWSER_USE_DIR=./mcp-browser-use
# MCP_BROWSER_USE_HTTP_URL=http://127.0.0.1:8383/mcp
# Browser bridge stays loopback-only by default; direct access requires a shared secret.
# MCP_BROWSER_SERVER_URL=http://127.0.0.1:5001
# MCP_BROWSER_SERVER_SECRET=change-me-long-random-secret
# MCP_BROWSER_SERVER_ALLOWED_ORIGINS=https://anton.local:8000,https://localhost:8000
# MCP_BROWSER_CDP_URL=http://localhost:9222
# MCP_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# MCP_BROWSER_USER_DATA_DIR=./scratch/chrome-profile
# MCP_BROWSER_PROFILE_DIRECTORY=Default
# MCP_BROWSER_PROXY_SERVER=http://host:8080
# MCP_BROWSER_PROXY_BYPASS=localhost,127.0.0.1
MCP_BROWSER_CHROMIUM_SANDBOX=true

MCP_AGENT_MAX_STEPS=20
MCP_AGENT_USE_VISION=true

MCP_RESEARCH_SAVE_DIRECTORY=./scratch
# MCP_RESEARCH_MAX_SEARCHES=5
# MCP_RESEARCH_SEARCH_TIMEOUT=120

MCP_SERVER_LOGGING_LEVEL=INFO
# MCP_SERVER_TRANSPORT=streamable-http
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8383
# MCP_SERVER_RESULTS_DIR=./scratch/mcp-results
# MCP_SERVER_AUTH_TOKEN=

HTTPS_CERT_HOSTNAME=anton.local
# CATBOT_PROXY_BASE_URL=http://localhost:8002
# PROXY_BASE_URL=http://localhost:8002
# BACKEND_URL=http://localhost:8002
PROXY_LOG_FILE=./logs/proxy_server.log
# PROXY_RESTART_DELAY_SECONDS=1.0
# Optional: set when you start browser-use via its own daemon mode and want dashboard log previews.
# BROWSER_USE_LOG_FILE=

# === Search / Weather ===
# BRAVE_API_KEY=
# NEWS_API_KEY=
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_TIMEOUT_SECONDS=12
OPEN_METEO_TRUST_ENV=false
# OPEN_METEO_USER_AGENT=CATBot/1.0
# BOM_API_TIMEOUT_SECONDS=12
# BOM_API_TRUST_ENV=false
# BOM_API_USER_AGENT=CATBot/1.0

# === Web UI TTS / STT ===
# TTS_ENDPOINT=http://localhost:4123/v1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
TTS_PROXY_TIMEOUT_SECONDS=180
# WHISPER_ENDPOINT=http://localhost:8001/v1/audio/transcriptions
# WHISPER_API_KEY=

# Embedded TTS served by proxy_server itself.
# If you enable Kitten TTS on Windows, install eSpeak NG and ensure espeak-ng is on PATH.
# EMBEDDED_KITTEN_TTS_ENABLED=false
# EMBEDDED_KITTEN_MODEL=KittenML/kitten-tts-nano-0.2
# EMBEDDED_KITTEN_DEFAULT_VOICE=expr-voice-2-f
# EMBEDDED_KITTEN_VOICES=expr-voice-2-f,expr-voice-3-f,expr-voice-4-m,expr-voice-5-m,expr-voice-2-m,expr-voice-5-f
EMBEDDED_KITTEN_SAMPLE_RATE=24000
EMBEDDED_KITTEN_STREAM_CHUNK_BYTES=4096
EMBEDDED_KITTEN_MAX_INPUT_CHARS=220
EMBEDDED_KITTEN_CHUNK_SILENCE_MS=80
# EMBEDDED_POCKET_TTS_ENABLED=false
# EMBEDDED_POCKET_MODEL=pocket-tts-realtime
# EMBEDDED_POCKET_VARIANT=b6369a24
# EMBEDDED_POCKET_DEFAULT_VOICE=alba
# EMBEDDED_POCKET_VOICE_DIR=voices
# Add custom Pocket prompt/state files to the voice list with absolute paths, or leave them in EMBEDDED_POCKET_VOICE_DIR to auto-discover them.
# EMBEDDED_POCKET_VOICES=alba,marius,javert,jean,fantine,cosette,eponine,azelma
EMBEDDED_POCKET_STREAM_CHUNK_BYTES=4096
# Fast desktop utterance defaults for Pocket TTS. Lower values reduce latency at a small quality/prosody cost.
EMBEDDED_POCKET_MAX_TOKENS=24
EMBEDDED_POCKET_FRAMES_AFTER_EOS=1
# EMBEDDED_POCKET_TEMPERATURE=0.7
# EMBEDDED_POCKET_LSD_DECODE_STEPS=1
# EMBEDDED_POCKET_NOISE_CLAMP=
# EMBEDDED_POCKET_EOS_THRESHOLD=-4.0

# === Telegram bot ===
# Required for bot:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=123456789
# TELEGRAM_ALLOW_ALL=false
# TELEGRAM_BACKEND_URL=http://localhost:8002
# TELEGRAM_CHAT_ENDPOINT=/v1/telegram/chat
# TELEGRAM_CHAT_MODEL=gpt-4o-mini
# TELEGRAM_CHAT_TIMEOUT=30
# TELEGRAM_CHAT_TIMEOUT_HARD_CAP=120
# TELEGRAM_TOOL_FOLLOWUP_TIMEOUT=45
# TELEGRAM_BOT_CHAT_TIMEOUT_HARD_CAP=10800
# Required when the proxy can be reached from anywhere except loopback.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TELEGRAM_SECRET=
# TELEGRAM_MAX_ATTACHMENT_BYTES=10485760
# TELEGRAM_HISTORY_LIMIT=12
# TELEGRAM_SYSTEM_PROMPT=
# TELEGRAM_MODEL=
# TELEGRAM_OPENAI_BASE_URL=
# TELEGRAM_OPENAI_CHAT_PATH=/chat/completions
# TELEGRAM_VOICE_IN=true
# TELEGRAM_VOICE_OUT=false
# TELEGRAM_TTS_MODEL=pocket-tts-realtime
# TELEGRAM_TTS_VOICE=alloy
# TELEGRAM_TRANSCRIBE_ENDPOINT=/v1/audio/transcriptions
# TELEGRAM_TRANSCRIBE_MODEL=whisper-1
# TELEGRAM_MAX_VOICE_SECONDS=300
# TELEGRAM_SEND_TRANSCRIPT=true
# TELEGRAM_TOOLS_ENABLED=false
# TELEGRAM_TOOLS_MAX_ITERATIONS=5
# TELEGRAM_DEEP_RESEARCH_STALE_SECONDS=21600

# === Todo / task execution / large payload controls ===
TODO_DATA_PATH=./todo_data
# TASK_EXECUTION_MAX_ITERATIONS=200
MAX_TOKEN_LIMIT=256000
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4
LIST_FILES_TOOL_MAX_ENTRIES=60
LARGE_PAYLOAD_MODEL=
LARGE_PAYLOAD_ENDPOINT=

# === Memory / embeddings / extraction ===
# MEMORY_ENABLED=true
MEMORY_STORAGE_PATH=./memory_data
# MEMORY_DATABASE_NAME=memory.sqlite3
# MEMORY_EMBEDDING_VERSION=v1
# MEMORY_EMBEDDING_MAX_ATTEMPTS=2
# MEMORY_SEARCH_LIMIT=5
# MEMORY_SIMILARITY_THRESHOLD=0.7
# MEMORY_AUTO_EXTRACT=true
# MEMORY_EXTRACT_MIN_USER_MESSAGES=2
# MEMORY_EXTRACT_MIN_USER_CHARS=80
# MEMORY_EXTRACT_ALLOWED_CONFIDENCE=high
# MEMORY_EXTRACTOR_VERSION=schema-v2
# MEMORY_AUTO_SEARCH_CANDIDATE_THRESHOLD=0.45
# MEMORY_AUTO_SEARCH_LIMIT=3
# EMBEDDINGS_API_BASE=
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=
# MEMORY_EXTRACTOR_API_BASE=
# MEMORY_EXTRACTOR_MODEL=gpt-4o-mini
# MEMORY_EXTRACTOR_API_KEY=
# MEMORY_EXTRACTOR_REQUIRE_KEY=false
# MEMORY_EXTRACTOR_USE_JSON_FORMAT=false

# === Google Drive upload integration ===
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_PROJECT_ID=
# GOOGLE_DRIVE_PRIVATE_KEY_ID=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_CLIENT_EMAIL=

# === GitHub project manager skill ===
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_TARGET_REPOSITORY=owner/repo
# GITHUB_API_BASE=https://api.github.com
# GITHUB_DEFAULT_BRANCH=main
# GITHUB_PROTECTED_BRANCHES=main
# GITHUB_BLOCKED_PATH_PATTERNS=
# GITHUB_SENSITIVE_PATH_ALLOWLIST=
# GIT_AUTHOR_NAME=CATBot
# GIT_AUTHOR_EMAIL=catbot@users.noreply.github.com
# GIT_REMOTE_NAME=origin
# VERSION_FILE=VERSION
# CATBOT_WORKSPACE=.

# === Google Workspace CLI integration ===
# GOOGLE_WORKSPACE_CLI_BIN=
# GOOGLE_WORKSPACE_CLI_CONFIG_DIR=

# === Image generation skill (OpenRouter Seedream) ===
# IMAGE_GENERATION_OPENROUTER_API_KEY=
# IMAGE_GENERATION_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# IMAGE_GENERATION_API_KEY=
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_REFERER=
# OPENROUTER_X_TITLE=CATBot

# === Spotify playback skill ===
# Register the redirect URI in Spotify before authorizing CATBot.
# Do not use localhost; use the same trusted hostname as HTTPS_CERT_HOSTNAME.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://anton.local:8002/spotify/callback
# SPOTIFY_REFRESH_TOKEN=
# SPOTIFY_ACCESS_TOKEN=
# SPOTIFY_DEVICE_ID=

# === Codex CLI tool ===
# CODEX_ENABLED=true
# CODEX_CLI_PATH=codex
# CODEX_SANDBOX_MODE=workspace-write
# CODEX_APPROVAL_POLICY=never
# CODEX_ENABLE_SEARCH=true
# CODEX_TIMEOUT_SECONDS=1800
# CODEX_JSON_EVENTS=true
# CODEX_OUTPUT_LAST_MESSAGE=true

# === AutoGen / workflows / protected local routes ===
WORKFLOW_FRAMEWORK=autogen
# Allowed: autogen, ag2
AUTOGEN_REQUIRE_AUTH=true
AUTOGEN_ENABLE_CODE_EXECUTION=false
# AUTOGEN_TEAM_SECRET=
# CATBOT_AGENT_SECRET=
# Reuse an existing internal secret or set MCP_BROWSER_SERVER_SECRET explicitly for the Flask browser bridge.
# AUTOGEN_TEAM_MODEL=
# AUTOGEN_OPENROUTER_BASE_URL=
# OPENROUTER_AUTOGEN_MODEL=
# AUTOGEN_BASE_URL=
# AUTOGEN_MINIMAX_BASE_URL=
# AUTOGEN_MINIMAX_MODEL=
# AG2_MODEL=
# AG2_BASE_URL=
# AG2_API_KEY=
AG2_API_TYPE=openai
AG2_MAX_ROUNDS=24
AG2_ENABLE_CODE_EXECUTION=false

# === Scheduled task poller / philosopher mode / monitoring ===
# SCHEDULED_TASK_POLLER_PROXY_URL=http://localhost:8002
# SCHEDULED_TASK_POLLER_USERS_FILE=./config/auth_users.json
# PHILOSOPHER_MODE_ENABLED=true
# PHILOSOPHER_MAX_CYCLES=10
# PHILOSOPHER_SIMILARITY_THRESHOLD=0.3
# PHILOSOPHER_MEMORY_LIMIT=10
# PHILOSOPHER_CONVERSATION_HISTORY_LIMIT=3
# PHILOSOPHER_DIVERSIFICATION_THRESHOLD=7
# STATUS_UPDATE_INTERVAL_SECONDS=60
# MONITOR_RUN_HISTORY_LIMIT=25
# MONITOR_LOG_PREVIEW_LINES=80
# MONITOR_RUN_LOG_MAX_BYTES=1048576
# MONITOR_BROWSER_HEALTH_MAX_AGE_SECONDS=15

# === Security / upload limits ===
# Required for stable sessions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=82800
# Public signup is off after first-user bootstrap unless explicitly enabled or protected by invite code.
# AUTH_ALLOW_PUBLIC_SIGNUP=false
# AUTH_BOOTSTRAP_FIRST_USER=true
# AUTH_SIGNUP_INVITE_CODE=
# CORS defaults allow local/private origins only. Use explicit origins for deployed browser clients.
# CATBOT_CORS_ALLOWED_ORIGINS=https://catbot.example.com
# CATBOT_CORS_ALLOW_ALL=false
# Server-side fetch/proxy blocks private networks unless the endpoint is configured as trusted.
# CATBOT_OUTBOUND_ALLOW_PRIVATE=false
# Prefer an exact allowlist for local OpenAI-compatible model servers (Ollama, LM Studio, vLLM).
# OPENAI_PROXY_TRUSTED_BASE_URLS=http://127.0.0.1:11434/v1,http://192.168.1.50:1234/v1
# Broader model-only opt-in; private model requests still require CATBot authentication.
# OPENAI_PROXY_ALLOW_PRIVATE=false
# PROXY_FETCH_ALLOW_JS_RENDER=false
# PROXY_FETCH_MAX_REDIRECTS=5
# PROXY_FETCH_MAX_RESPONSE_BYTES=5242880
# FILE_OPS_MAX_SIZE=10485760
# SEARCH_FILE_MAX_SIZE=1048576
# ATTACHMENT_MAX_FILES_PER_REQUEST=6
