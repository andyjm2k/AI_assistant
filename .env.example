# This is an example .env file. Copy it to .env and fill in your values.
# Lines starting with # are comments.

# === Main LLM Configuration (MCP_LLM_*) ===
# Select the primary LLM provider
# Options: openai, azure_openai, anthropic, google, mistral, ollama, deepseek, openrouter, alibaba, moonshot, unbound
# MCP_LLM_PROVIDER=google
# MCP_LLM_PROVIDER=openai
MCP_LLM_PROVIDER=ollama
# Specify the model name for the selected provider
# MCP_LLM_MODEL_NAME=gemini-2.5-flash
MCP_LLM_MODEL_NAME=qwen3-vl:8b
# MCP_LLM_MODEL_NAME=gpt-5-mini
# LLM temperature (0.0-2.0). Controls randomness.
MCP_LLM_TEMPERATURE=1
# Optional: Generic override for the LLM provider's base URL
# MCP_LLM_BASE_URL=
# Optional: Generic override for the LLM provider's API key. Takes precedence over provider-specific keys.
# MCP_LLM_API_KEY=X

# --- Provider Specific API Keys (MCP_LLM_*) ---
# Required unless using Ollama locally without auth or generic MCP_LLM_API_KEY is set
MCP_LLM_OPENAI_API_KEY=x
# MCP_LLM_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
MCP_LLM_GOOGLE_API_KEY=x
# MCP_LLM_AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
# MCP_LLM_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# MCP_LLM_MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
# MCP_LLM_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# MCP_LLM_ALIBABA_API_KEY=YOUR_ALIBABA_API_KEY
# MCP_LLM_MOONSHOT_API_KEY=YOUR_MOONSHOT_API_KEY
# MCP_LLM_UNBOUND_API_KEY=YOUR_UNBOUND_API_KEY

# --- Provider Specific Endpoints (MCP_LLM_*) ---
# Optional: Override default API endpoints.
MCP_LLM_OPENAI_ENDPOINT=https://api.openai.com/v1
# MCP_LLM_OPENAI_ENDPOINT=http://192.168.1.105:1234/v1
# MCP_LLM_ANTHROPIC_ENDPOINT=https://api.anthropic.com
# MCP_LLM_AZURE_OPENAI_ENDPOINT=YOUR_AZURE_ENDPOINT # Required if using Azure, e.g., https://your-resource.openai.azure.com/
# MCP_LLM_AZURE_OPENAI_API_VERSION=2025-01-01-preview
# MCP_LLM_DEEPSEEK_ENDPOINT=https://api.deepseek.com
# MCP_LLM_MISTRAL_ENDPOINT=https://api.mistral.ai/v1
MCP_LLM_OLLAMA_ENDPOINT=http://localhost:11434
# MCP_LLM_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
# MCP_LLM_ALIBABA_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# MCP_LLM_MOONSHOT_ENDPOINT=https://api.moonshot.cn/v1
# MCP_LLM_UNBOUND_ENDPOINT=https://api.getunbound.ai

# --- Ollama Specific (MCP_LLM_*) ---
MCP_LLM_OLLAMA_NUM_CTX=32000
MCP_LLM_OLLAMA_NUM_PREDICT=1024

# === Planner LLM Configuration (Optional, MCP_LLM_PLANNER_*) ===
# If you want to use a different LLM for planning tasks within agents.
# Defaults to main LLM settings if not specified.
# MCP_LLM_PLANNER_PROVIDER=
# MCP_LLM_PLANNER_MODEL_NAME=
# MCP_LLM_PLANNER_TEMPERATURE=
# MCP_LLM_PLANNER_BASE_URL=
# MCP_LLM_PLANNER_API_KEY= # Generic planner API key, or use provider-specific below
# MCP_LLM_PLANNER_OPENAI_API_KEY=
# ... (similar provider-specific keys and endpoints for planner if needed)

# === Browser Configuration (MCP_BROWSER_*) ===
# General browser headless mode (true/false)
MCP_BROWSER_HEADLESS=false
# General browser disable security features (use cautiously) (true/false)
MCP_BROWSER_DISABLE_SECURITY=false
# Optional: Path to Chrome/Chromium executable
# MCP_BROWSER_BINARY_PATH=/usr/bin/chromium-browser
# Optional: Path to Chrome user data directory (for persistent sessions)
# MCP_BROWSER_USER_DATA_DIR=~/.config/google-chrome/Profile 1
MCP_BROWSER_WINDOW_WIDTH=1920
MCP_BROWSER_WINDOW_HEIGHT=1080
# Set to true to connect to user's browser via MCP_BROWSER_CDP_URL
MCP_BROWSER_USE_OWN_BROWSER=false
# Optional: Connect to existing Chrome via DevTools Protocol URL. Required if MCP_BROWSER_USE_OWN_BROWSER=true.
# MCP_BROWSER_CDP_URL=http://localhost:9222
# MCP_BROWSER_WSS_URL= # Optional: WSS URL if CDP URL is not sufficient
# Keep browser managed by server open between MCP tool calls (if MCP_BROWSER_USE_OWN_BROWSER=false)
MCP_BROWSER_KEEP_OPEN=false
# URL of the mcp-server-browser-use HTTP server (proxy and Flask bridge connect here). Start the server with: uv run mcp-server-browser-use server (in mcp-browser-use directory).
# MCP_BROWSER_USE_HTTP_URL=http://127.0.0.1:8383/mcp
# Optional: Directory to save Playwright trace files (useful for debugging). If not set, tracing to file is disabled.
# MCP_BROWSER_TRACE_PATH=./tmp/trace

# === Agent Tool Configuration (`run_browser_agent` tool, MCP_AGENT_TOOL_*) ===
MCP_AGENT_TOOL_MAX_STEPS=20
MCP_AGENT_TOOL_MAX_ACTIONS_PER_STEP=5
# Method for tool invocation ('auto', 'json_schema', 'function_calling')
MCP_AGENT_TOOL_TOOL_CALLING_METHOD=auto
MCP_AGENT_TOOL_MAX_INPUT_TOKENS=128000
# Enable vision capabilities (screenshot analysis)
MCP_AGENT_TOOL_USE_VISION=true
# Override general browser headless mode for this tool (true/false/empty for general setting)
# MCP_AGENT_TOOL_HEADLESS=
# Override general browser disable security for this tool (true/false/empty for general setting)
# MCP_AGENT_TOOL_DISABLE_SECURITY=
# Enable Playwright video recording (true/false)
MCP_AGENT_TOOL_ENABLE_RECORDING=true
# Optional: Path to save agent run video recordings. If not set, recording to file is disabled even if ENABLE_RECORDING=true.
MCP_AGENT_TOOL_SAVE_RECORDING_PATH=C:\\Users\\andyj\\AI_assistant\\research
# Optional: Directory to save agent history JSON files. If not set, history saving is disabled.
MCP_AGENT_TOOL_HISTORY_PATH=C:\\Users\\andyj\\AI_assistant\\research\\agent_history

# === Deep Research Tool Configuration (`run_deep_research` tool, MCP_RESEARCH_TOOL_*) ===
MCP_RESEARCH_TOOL_MAX_PARALLEL_BROWSERS=3
# MANDATORY: Base directory to save research artifacts (report, results). Task ID will be appended.
# Example: MCP_RESEARCH_TOOL_SAVE_DIR=/mnt/data/research_outputs
# Example: MCP_RESEARCH_TOOL_SAVE_DIR=C:\\Users\\YourUser\\Documents\\ResearchData
MCP_RESEARCH_TOOL_SAVE_DIR=C:\\Users\\andyj\\AI_assistant\\research

# === Path Configuration (MCP_PATHS_*) ===
# Optional: Directory for downloaded files. If not set, persistent downloads to a specific path are disabled.
MCP_PATHS_DOWNLOADS=C:\\Users\\andyj\\AI_assistant\\research\\downloads

# === Server Configuration (MCP_SERVER_*) ===
# Path for the server log file. Leave empty for stdout.
MCP_SERVER_LOG_FILE=C:\\Users\\andyj\\AI_assistant\\research\\mcp_server_browser_use.log
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_SERVER_LOGGING_LEVEL=INFO
# Enable/disable anonymized telemetry (true/false)
MCP_SERVER_ANONYMIZED_TELEMETRY=true
# Proxy server auto-reload on code changes (true/false). Disable to avoid restarts during editing.
PROXY_RELOAD=false
# Optional: JSON string for MCP client configuration for the controller
# MCP_SERVER_MCP_CONFIG='{"client_name": "mcp-browser-use-controller"}'

# === Web UI TTS Defaults (Optional) ===
# These values will populate the web UI TTS settings when present.
# TTS_ENDPOINT=http://localhost:4123/v1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# === Embedded Kitten TTS in proxy_server (Optional) ===
# Enable OpenAI-compatible endpoints served directly by CATBot proxy:
#   GET  /v1/audio/voices
#   POST /v1/audio/speech
# Then point TTS_ENDPOINT to your proxy base URL, e.g. http://localhost:8002
# EMBEDDED_KITTEN_TTS_ENABLED=false
# EMBEDDED_KITTEN_MODEL=KittenML/kitten-tts-nano-0.2
# EMBEDDED_KITTEN_DEFAULT_VOICE=expr-voice-2-f
# EMBEDDED_KITTEN_VOICES=expr-voice-2-f,expr-voice-3-f,expr-voice-4-m,expr-voice-5-m,expr-voice-2-m,expr-voice-5-f
# Embedded performance defaults (safe even when embedded TTS is disabled):
EMBEDDED_KITTEN_SAMPLE_RATE=24000
EMBEDDED_KITTEN_STREAM_CHUNK_BYTES=4096
EMBEDDED_KITTEN_MAX_INPUT_CHARS=220
EMBEDDED_KITTEN_CHUNK_SILENCE_MS=80
# Proxy timeout when forwarding TTS requests (seconds)
TTS_PROXY_TIMEOUT_SECONDS=180

# === Telegram Bot (Optional) ===
# See config/telegram_env_example.txt for full list and details.
# Required (bot): TELEGRAM_BOT_TOKEN, TELEGRAM_ADMIN_IDS (or TELEGRAM_ALLOW_ALL=true)
# Required (proxy): OPENAI_API_KEY or MCP_LLM_OPENAI_API_KEY for chat
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_ADMIN_IDS=your_telegram_user_id
# TELEGRAM_ALLOW_ALL=false
# TELEGRAM_BACKEND_URL=http://localhost:8002
# TELEGRAM_CHAT_ENDPOINT=/v1/telegram/chat
# TELEGRAM_CHAT_MODEL=gpt-4o-mini
# TELEGRAM_SECRET=  # Recommended for any production/remote setup; required for authenticated Telegram file attachments (sendTelegramFile)
# TELEGRAM_VOICE_OUT=false
# TELEGRAM_TTS_VOICE=alloy
# TELEGRAM_TOOLS_ENABLED=false  # Set true on proxy to enable tools (search, files, todo, memory, etc.)
# TELEGRAM_TOOLS_MAX_ITERATIONS=5  # Max tool loop iterations per message when tools enabled
# listFiles supports optional args: path (subdirectory under scratch) and recursive (true/false).
# sendTelegramFile supports subdirectory paths under scratch (e.g. images/generated/file.png).
# When tools enabled, optional for full features: BRAVE_API_KEY, NEWS_API_KEY, GOOGLE_DRIVE_*, MEMORY_*
# MEMORY_EXTRACT_MIN_USER_MESSAGES=2   # Min user messages before running extraction (default 2)
# MEMORY_EXTRACT_MIN_USER_CHARS=80     # Min total user content length before extraction (default 80)
# Todo list is stored per user in todo_data/ (or TODO_DATA_PATH). Task execution uses same backend.
# TASK_EXECUTION_MAX_ITERATIONS=200  # Max LLM+tool iterations per task execution run (default 200)
# TODO_DATA_PATH=todo_data  # Optional: directory for per-user todo JSON files (default: project_root/todo_data)

# === Context Window Controls ===
# Maximum total tokens (input + output) allowed in a single LLM request.
# The server will preflight, summarize, and retry when the request would exceed this limit.
MAX_TOKEN_LIMIT=256000
# Optional: tweak token estimation when a tokenizer is unavailable.
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4
# Maximum number of entries returned in LLM-facing list-files tool replies (listFiles/list_files).
# listFiles can be scoped with path/recursive, but this cap still applies to the rendered output.
# Lower this if scratch has many files and tool responses are too large for chat context.
LIST_FILES_TOOL_MAX_ENTRIES=60

# === Large Payload Fallback ===
# Optional model to retry with when context window exhaustion occurs.
LARGE_PAYLOAD_MODEL=
# Optional: override endpoint for the large payload model (must be OpenAI-compatible).
LARGE_PAYLOAD_ENDPOINT=

# --- Codex CLI Tool (Optional) ---
# Enable/disable the Codex CLI tool endpoint
# CODEX_ENABLED=true
# Path to codex executable (defaults to "codex" if on PATH)
# CODEX_CLI_PATH=codex
# Codex sandbox mode: read-only | workspace-write | danger-full-access
# CODEX_SANDBOX_MODE=workspace-write
# Approval policy for Codex exec: untrusted | on-request | on-failure | never
# CODEX_APPROVAL_POLICY=never
# Enable Codex built-in web search tool
# CODEX_ENABLE_SEARCH=true
# Default timeout in seconds (30 minutes)
# CODEX_TIMEOUT_SECONDS=1800

BRAVE_API_KEY=x
NEWS_API_KEY=x

# --- Weather Tool (Open-Meteo) ---
# Optional override for Open-Meteo forecast endpoint used by weatherInfo tool.
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional override for Open-Meteo geocoding endpoint used by weatherInfo tool.
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# Request timeout in seconds for Open-Meteo weather calls.
OPEN_METEO_TIMEOUT_SECONDS=12
# Whether Open-Meteo weather calls should honor HTTP(S)_PROXY/ALL_PROXY env vars.
# Keep false for direct network access unless you intentionally use an outbound proxy.
OPEN_METEO_TRUST_ENV=false
