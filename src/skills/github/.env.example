# CATBot GitHub skill example settings

CATBOT_WORKSPACE=.

# Optional unless using PR/release APIs
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=CATBot
GITHUB_API_BASE=https://api.github.com

GITHUB_DEFAULT_BRANCH=main
GITHUB_TARGET_REPOSITORY=your-org-or-user/CATBot
GITHUB_ENFORCE_BRANCH_PR_FLOW=true
GITHUB_PROTECTED_BRANCHES=main,master
GITHUB_ENFORCE_SENSITIVE_PATH_GUARD=true
# Comma-separated globs checked before commit/push/PR creation.
GITHUB_BLOCKED_PATH_PATTERNS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,*.jks,*.pkcs12,id_rsa,id_rsa.*,id_ed25519,id_ed25519.*,certs/*,config/*.env,config/*.env.*,config/*.json,config/**/*.json,config/*secret*,config/*credentials*,config/*private*
# Optional allowlist for non-secret templates/examples.
GITHUB_SENSITIVE_PATH_ALLOWLIST=*.example,*.sample,*.template,*.dist
GIT_REMOTE_NAME=origin
GIT_AUTHOR_NAME=CATBot
GIT_AUTHOR_EMAIL=catbot@users.noreply.github.com
VERSION_FILE=VERSION
