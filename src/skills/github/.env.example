# CATBot GitHub skill example settings

CATBOT_WORKSPACE=.

# Optional unless using PR/release APIs
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=CATBot
GITHUB_API_BASE=https://api.github.com

GITHUB_DEFAULT_BRANCH=main
GIT_REMOTE_NAME=origin
GIT_AUTHOR_NAME=CATBot
GIT_AUTHOR_EMAIL=catbot@users.noreply.github.com
VERSION_FILE=VERSION
